# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/

# Conda
.env
.conda/

# VS Code
.vscode/

# JetBrains
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Generated model files
models/model_*
models/*.pt
models/*.pth

# Temporary training outputs
*.tmp

# Stale generated outputs from the deprecated baseline scripts (not present
# in this branch, but their old output files may still sit on disk locally)
alarm.txt
groundtruth_nodeId.txt
groundtruth_uuid.txt
id_to_uuid.txt
training_log.txt
result_*

# Unrelated dataset dirs (streamspot/unicornsc parsers aren't in this branch)
graphchi-cpp-master/graph_data/streamspot/
graphchi-cpp-master/graph_data/unicornsc/

# Parsed provenance TSVs -- large (~580 MB each), not versioned.
# Place cadets_train.txt / cadets_test.txt here manually before running
# anything; see graphchi-cpp-master/graph_data/darpatc/PLACE_DATA_HERE.md
# and the root README.md.
graphchi-cpp-master/graph_data/darpatc/*_train.txt
graphchi-cpp-master/graph_data/darpatc/*_test.txt

# Raw DARPA tarballs and any extracted intermediate JSON
graphchi-cpp-master/graph_data/darpatc/*.tar.gz
graphchi-cpp-master/graph_data/darpatc/*.json
graphchi-cpp-master/graph_data/darpatc/*.json.*

# Jupyter
.ipynb_checkpoints/

# Ignore everything else under the data directory by default, but keep the
# placeholder doc that documents what goes here.
graphchi-cpp-master/graph_data/darpatc/*
!graphchi-cpp-master/graph_data/darpatc/PLACE_DATA_HERE.md

# Example Models
example_models/

# Generated artifacts (checkpoints, score files, logs stay untracked), but
# keep the three seedrun driver scripts tracked. models/** + !models/**/
# (instead of a bare models/) lets git descend into the tree so the
# re-includes below work.
models/**
!models/**/
!models/**/*.sh

# Required data, not regenerated by any script -- must stay tracked or the
# run_*_seedrun.sh drivers break on a fresh clone.
!models/cadets_node_vocab.txt
!models/windowed_cadets/groundtruth_raw_global_id.txt

# Archives
*.tar.gz
