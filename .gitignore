# Datasets / preprocessing
# Ignore everything inside dataset folders
graphchi-cpp-master/graph_data/darpatc/*
graphchi-cpp-master/graph_data/streamspot/*
graphchi-cpp-master/graph_data/unicornsc/*

# But keep the directory itself
!graphchi-cpp-master/graph_data/darpatc/.gitkeep
!graphchi-cpp-master/graph_data/streamspot/.gitkeep
!graphchi-cpp-master/graph_data/unicornsc/.gitkeep

# Example Models
example_models/

# Generated artifacts (checkpoints, score files, logs stay untracked),
# but keep experiment drivers, preregistrations, and per-epoch metric
# tables under models/ tracked. models/** + !models/**/ (instead of a
# bare models/) lets git descend into the tree so the re-includes work.
models/**
!models/**/
!models/**/*.sh
!models/**/*.py
!models/**/*.tsv
!models/**/PREREGISTRATION.md
# Fixed reference ground truth (raw/Orthrus-style GT: 48 attack global-IDs),
# hand-derived and not regenerated by any script -- must stay tracked or
# every run_*_seedrun.sh / analyze_e3.py / analyze_aggscoring.py that reads
# it via RAWGT breaks on a fresh clone (e.g. the GPU machine).
!models/windowed_cadets/groundtruth_raw_global_id.txt
result_*

# Archives
*.tar.gz